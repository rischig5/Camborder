<html>
<head>
<title>Camborder</title>
<HTA:APPLICATION
  ID="camborderLauncher"
  APPLICATIONNAME="Camborder"
  BORDER="thin"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  SYSMENU="yes"
  SCROLL="no"
  SINGLEINSTANCE="yes"
/>
<style>
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    width: 340px;
    height: 460px;
    background: #0e0e10;
    color: #efeff1;
    font-family: 'Segoe UI', Arial, sans-serif;
    overflow: hidden;
  }
  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
    padding: 22px 20px;
  }
  h1 {
    font-size: 18px;
    margin: 0 0 2px;
    background: linear-gradient(90deg, #9146FF, #00D8D8);
    -webkit-background-clip: text;
    color: transparent;
    letter-spacing: 0.02em;
  }
  .sub {
    font-size: 11px;
    color: #adadb8;
    margin-bottom: 26px;
    text-align: center;
  }
  #btn {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    background: radial-gradient(circle at 35% 30%, #a35bff, #9146FF 55%, #6a2fd9);
    box-shadow: 0 0 0 6px rgba(145, 70, 255, 0.12), 0 0 30px 4px rgba(145, 70, 255, 0.45);
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.06em;
    transition: transform 0.12s ease, box-shadow 0.2s ease;
  }
  #btn:hover { transform: scale(1.03); }
  #btn:active { transform: scale(0.97); }
  #btn.running {
    background: radial-gradient(circle at 35% 30%, #ff6a6a, #e24545 55%, #b52c2c);
    box-shadow: 0 0 0 6px rgba(226, 69, 69, 0.12), 0 0 30px 4px rgba(226, 69, 69, 0.45);
  }
  #btn.busy {
    background: radial-gradient(circle at 35% 30%, #555, #333 55%, #222);
    box-shadow: 0 0 0 6px rgba(255,255,255,0.05);
    cursor: default;
  }
  #btn:disabled { pointer-events: none; }

  .status {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #dedee3;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #6d6d76;
  }
  .dot.on {
    background: #3ad66d;
    box-shadow: 0 0 8px 1px rgba(58, 214, 109, 0.8);
  }
  .dot.pulse { animation: pulse 1.4s infinite ease-in-out; }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .links {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .links button {
    background: #202024;
    border: 1px solid #35353b;
    color: #efeff1;
    border-radius: 6px;
    padding: 9px;
    font-size: 12px;
    cursor: pointer;
  }
  .links button:hover { background: #2a2a30; }
  .links button:disabled { opacity: 0.4; cursor: default; }

  .err {
    margin-top: 14px;
    font-size: 11px;
    color: #ff8080;
    text-align: center;
    min-height: 14px;
  }
</style>
</head>
<body>
  <div class="wrap">
    <h1>Camborder</h1>
    <div class="sub">Local overlay server</div>

    <button id="btn" onclick="toggleServer()">START</button>

    <div class="status">
      <div id="dot" class="dot"></div>
      <span id="statusText">Checking...</span>
    </div>

    <div class="err" id="errText"></div>

    <div class="links">
      <button id="openSettings" onclick="openUrl('http://localhost:5173/settings.html')" disabled>Open Settings Panel</button>
      <button id="openOverlay" onclick="openUrl('http://localhost:5173/overlay.html')" disabled>Open Overlay Preview</button>
    </div>
  </div>

<script language="VBScript">
Dim PORT, BASE_URL, PROJECT_DIR, isRunning, pollAttempts

PORT = "5173"
BASE_URL = "http://localhost:" & PORT

Sub Window_OnLoad
  PROJECT_DIR = GetProjectDir()
  isRunning = False
  RefreshStatus
End Sub

Function GetProjectDir()
  Dim fso
  Set fso = CreateObject("Scripting.FileSystemObject")
  GetProjectDir = fso.GetParentFolderName(document.location.pathname)
End Function

Function IsServerUp()
  Dim xhr, ok
  ok = False
  On Error Resume Next
  Set xhr = CreateObject("Msxml2.XMLHTTP")
  xhr.open "GET", BASE_URL & "/api/settings", False
  xhr.send
  If Err.Number = 0 Then
    If xhr.status = 200 Then ok = True
  End If
  On Error Goto 0
  IsServerUp = ok
End Function

Sub RefreshStatus
  SetBusyUI "Checking..."
  If IsServerUp() Then
    isRunning = True
    SetRunningUI
  Else
    isRunning = False
    SetIdleUI
  End If
End Sub

Sub SetIdleUI
  btn.className = ""
  btn.innerText = "START"
  btn.disabled = False
  dot.className = "dot"
  statusText.innerText = "Not running"
  openSettings.disabled = True
  openOverlay.disabled = True
  errText.innerText = ""
End Sub

Sub SetRunningUI
  btn.className = "running"
  btn.innerText = "STOP"
  btn.disabled = False
  dot.className = "dot on pulse"
  statusText.innerText = "Running on port " & PORT
  openSettings.disabled = False
  openOverlay.disabled = False
  errText.innerText = ""
End Sub

Sub SetBusyUI(msg)
  btn.className = "busy"
  btn.disabled = True
  dot.className = "dot"
  statusText.innerText = msg
End Sub

Sub toggleServer()
  If isRunning Then
    StopServer
  Else
    StartServer
  End If
End Sub

Sub StartServer
  Dim shell
  SetBusyUI "Starting..."
  errText.innerText = ""
  On Error Resume Next
  Set shell = CreateObject("WScript.Shell")
  shell.Run "cmd /c cd /d """ & PROJECT_DIR & """ && node server.js", 0, False
  If Err.Number <> 0 Then
    errText.innerText = "Couldn't launch Node. Is it installed?"
    SetIdleUI
    Exit Sub
  End If
  On Error Goto 0
  pollAttempts = 0
  window.setTimeout "PollForStart", 500
End Sub

Sub PollForStart
  pollAttempts = pollAttempts + 1
  If IsServerUp() Then
    isRunning = True
    SetRunningUI
    OpenUrl BASE_URL & "/settings.html"
  ElseIf pollAttempts >= 20 Then
    errText.innerText = "Server didn't start. Check Node.js is installed and try again."
    SetIdleUI
  Else
    SetBusyUI "Starting..."
    window.setTimeout "PollForStart", 500
  End If
End Sub

Sub StopServer
  Dim proc, procs
  SetBusyUI "Stopping..."
  On Error Resume Next
  Set procs = GetObject("winmgmts:").ExecQuery( _
    "Select * from Win32_Process Where Name='node.exe'")
  For Each proc In procs
    If InStr(1, proc.CommandLine, "server.js", 1) > 0 Then
      proc.Terminate()
    End If
  Next
  On Error Goto 0
  window.setTimeout "PollForStop", 500
End Sub

Sub PollForStop
  If IsServerUp() Then
    window.setTimeout "PollForStop", 500
  Else
    isRunning = False
    SetIdleUI
  End If
End Sub

Sub openUrl(u)
  Dim shell
  Set shell = CreateObject("WScript.Shell")
  shell.Run u
End Sub
</script>
</body>
</html>
