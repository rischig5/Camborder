<html>
<head>
<meta http-equiv="x-ua-compatible" content="IE=edge" />
<title>Camborder</title>
<HTA:APPLICATION
  ID="camborderLauncher"
  APPLICATIONNAME="Camborder"
  ICON="camborder.ico"
  BORDER="thin"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  SYSMENU="yes"
  SCROLL="no"
  SINGLEINSTANCE="yes"
  WIDTH="360"
  HEIGHT="560"
  NAVIGABLE="no"
/>
<style>
  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    width: 360px;
    height: 560px;
    background: #0e0e10;
    color: #efeff1;
    font-family: 'Segoe UI', Arial, sans-serif;
    overflow: hidden;
  }

  /* Centering uses text-align + auto margins rather than flexbox: HTA can
     fall back to rendering modes where flex/gap do nothing at all. */
  .wrap {
    padding: 26px 22px 20px;
    text-align: center;
  }

  h1 {
    font-size: 23px;
    font-weight: 700;
    margin: 0 0 3px;
    letter-spacing: 0.02em;
  }
  /* Two colored spans, not gradient-clipped text: background-clip:text is
     unsupported here and would render the title invisible. */
  h1 .a { color: #9146FF; }
  h1 .b { color: #00D8D8; }

  .sub {
    font-size: 11px;
    color: #adadb8;
    margin: 0 0 26px;
  }

  #btn {
    display: block;
    margin: 0 auto;
    width: 172px;
    height: 172px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    color: #ffffff;
    font-family: inherit;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: #9146FF;
    background: radial-gradient(circle at 34% 28%, #b57bff 0%, #9146FF 52%, #6a2fd9 100%);
    box-shadow: 0 0 0 7px rgba(145, 70, 255, 0.13), 0 0 34px 6px rgba(145, 70, 255, 0.42);
    transition: transform 0.12s ease, box-shadow 0.2s ease;
  }
  #btn:hover { transform: scale(1.03); }
  #btn:active { transform: scale(0.97); }

  #btn.running {
    background: #e24545;
    background: radial-gradient(circle at 34% 28%, #ff8b8b 0%, #e24545 52%, #b52c2c 100%);
    box-shadow: 0 0 0 7px rgba(226, 69, 69, 0.13), 0 0 34px 6px rgba(226, 69, 69, 0.42);
  }
  #btn.busy {
    background: #33333a;
    background: radial-gradient(circle at 34% 28%, #55555f 0%, #33333a 52%, #232329 100%);
    box-shadow: 0 0 0 7px rgba(255, 255, 255, 0.04);
    cursor: default;
    color: #b9b9c2;
  }

  .status {
    margin-top: 26px;
    font-size: 13px;
    color: #dedee3;
  }
  .dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #6d6d76;
    margin-right: 7px;
    vertical-align: middle;
  }
  .dot.on {
    background: #3ad66d;
    box-shadow: 0 0 8px 1px rgba(58, 214, 109, 0.75);
  }
  .dot.pulse { animation: pulse 1.5s infinite ease-in-out; }
  @keyframes pulse {
    0%   { opacity: 1; }
    50%  { opacity: 0.3; }
    100% { opacity: 1; }
  }
  .status span { vertical-align: middle; }

  .err {
    margin-top: 12px;
    min-height: 30px;
    font-size: 11px;
    line-height: 1.45;
    color: #ff8a8a;
  }

  .links { margin-top: 6px; }
  .links button {
    display: block;
    width: 100%;
    margin: 0 0 8px;
    background: #202024;
    border: 1px solid #35353b;
    color: #efeff1;
    border-radius: 6px;
    padding: 10px;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .links button:hover { background: #2a2a30; border-color: #45454d; }
  .links button:disabled { opacity: 0.35; cursor: default; }
</style>
</head>
<body>
  <div class="wrap">
    <h1><span class="a">Cam</span><span class="b">border</span></h1>
    <div class="sub">Local overlay server</div>

    <button id="btn" onclick="doToggle()">START</button>

    <div class="status">
      <span id="dot" class="dot"></span><span id="statusText">Checking...</span>
    </div>

    <div class="err" id="errText"></div>

    <div class="links">
      <button id="settingsBtn" onclick="doOpenSettings()" disabled>Open Settings Panel</button>
      <button id="overlayBtn" onclick="doOpenOverlay()" disabled>Open Overlay Preview</button>
      <button id="obsBtn" onclick="doOpenObs()">Open OBS</button>
    </div>
  </div>

<script type="text/javascript">
/* JScript rather than VBScript on purpose: VBScript's statement-call syntax
   has parsing traps that abort the whole script block on load, which takes
   every button down with it and is invisible until you click something.

   Naming rule: no function here may share a name with an element id -
   element ids become global properties and would shadow the function. */

var PORT = 5173;
var BASE_URL = 'http://localhost:' + PORT;
var WIN_W = 360;
var WIN_H = 560;

var projectDir = '';
var isRunning = false;
var busy = false;
var pollAttempts = 0;

function el(id) {
  return document.getElementById(id);
}

function setText(id, text) {
  el(id).innerHTML = text;
}

/* file:// paths arrive slash-separated and percent-encoded, e.g.
   /C:/Users/me/My%20Folder/launcher.hta */
function findProjectDir() {
  var p = document.location.pathname;
  try { p = decodeURIComponent(p); } catch (e) { /* leave as-is */ }
  p = p.replace(/\//g, '\\');
  if (p.length >= 3 && p.charAt(0) === '\\' && p.charAt(2) === ':') {
    p = p.substring(1);
  }
  var cut = p.lastIndexOf('\\');
  return cut > 0 ? p.substring(0, cut) : p;   // no trailing slash
}

/* ServerXMLHTTP is preferred because it ignores the WinINet cache - plain
   XMLHTTP can replay a cached 200 and report a stopped server as running. */
function httpStatus(method, url, body) {
  var xhr = null;
  try {
    xhr = new ActiveXObject('MSXML2.ServerXMLHTTP.6.0');
  } catch (e) {
    try { xhr = new ActiveXObject('Msxml2.XMLHTTP'); } catch (e2) { return -1; }
  }
  try { xhr.setTimeouts(1500, 1500, 1500, 2500); } catch (e3) { /* not on XMLHTTP */ }
  try {
    xhr.open(method, url, false);
    xhr.setRequestHeader('Cache-Control', 'no-cache');
    xhr.send(body || '');
    return xhr.status;
  } catch (e4) {
    return -1;
  }
}

function isServerUp() {
  var url = BASE_URL + '/api/settings?t=' + new Date().getTime();
  return httpStatus('GET', url, null) === 200;
}

function setIdleUI() {
  busy = false;
  el('btn').className = '';
  setText('btn', 'START');
  el('btn').disabled = false;
  el('dot').className = 'dot';
  setText('statusText', 'Not running');
  el('settingsBtn').disabled = true;
  el('overlayBtn').disabled = true;
}

function setRunningUI() {
  busy = false;
  el('btn').className = 'running';
  setText('btn', 'STOP');
  el('btn').disabled = false;
  el('dot').className = 'dot on pulse';
  setText('statusText', 'Running on port ' + PORT);
  el('settingsBtn').disabled = false;
  el('overlayBtn').disabled = false;
  setText('errText', '');
}

function setBusyUI(msg) {
  busy = true;
  el('btn').className = 'busy';
  el('btn').disabled = true;
  el('dot').className = 'dot';
  setText('statusText', msg);
}

function applyState(up) {
  isRunning = up;
  if (up) { setRunningUI(); } else { setIdleUI(); }
}

function refreshStatus() {
  setBusyUI('Checking...');
  applyState(isServerUp());
}

/* Keeps START/STOP honest if the server is started or killed elsewhere. */
function heartbeat() {
  if (!busy) {
    var up = isServerUp();
    if (up !== isRunning) { applyState(up); }
  }
  window.setTimeout(heartbeat, 3000);
}

function doToggle() {
  if (busy) { return; }
  if (isRunning) { stopServer(); } else { startServer(); }
}

function startServer() {
  setBusyUI('Starting...');
  setText('errText', '');
  try {
    var shell = new ActiveXObject('WScript.Shell');
    shell.Run('cmd /c cd /d "' + projectDir + '" && node server.js', 0, false);
  } catch (e) {
    setText('errText', "Couldn't launch Node. Is Node.js installed?");
    setIdleUI();
    return;
  }
  pollAttempts = 0;
  window.setTimeout(pollForStart, 600);
}

function pollForStart() {
  pollAttempts++;
  if (isServerUp()) {
    applyState(true);
    openUrl(BASE_URL + '/settings.html');
  } else if (pollAttempts >= 20) {
    setText('errText', 'Server did not start. Check that Node.js is installed, then try again.');
    setIdleUI();
  } else {
    window.setTimeout(pollForStart, 500);
  }
}

/* Asks the server to exit via its own endpoint - no process hunting. */
function stopServer() {
  setBusyUI('Stopping...');
  setText('errText', '');
  httpStatus('POST', BASE_URL + '/api/shutdown', '');
  pollAttempts = 0;
  window.setTimeout(pollForStop, 400);
}

function pollForStop() {
  pollAttempts++;
  if (!isServerUp()) {
    applyState(false);
  } else if (pollAttempts >= 20) {
    setText('errText', 'Could not stop the server. End node.exe from Task Manager.');
    applyState(true);
  } else {
    window.setTimeout(pollForStop, 400);
  }
}

function openUrl(u) {
  try {
    new ActiveXObject('WScript.Shell').Run(u);
  } catch (e) {
    setText('errText', 'Could not open ' + u);
  }
}

function doOpenSettings() { openUrl(BASE_URL + '/settings.html'); }
function doOpenOverlay() { openUrl(BASE_URL + '/overlay.html'); }

function findObs() {
  var shell, fso;
  try {
    shell = new ActiveXObject('WScript.Shell');
    fso = new ActiveXObject('Scripting.FileSystemObject');
  } catch (e) {
    return '';
  }

  var i, base, exe;
  var tails = ['\\bin\\64bit\\obs64.exe', '\\bin\\32bit\\obs32.exe'];

  /* The installer's registry entry first, so installs on any drive work. */
  var regKeys = [
    'HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\OBS Studio\\InstallLocation',
    'HKLM\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\OBS Studio\\InstallLocation',
    'HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\OBS Studio\\InstallLocation'
  ];
  for (i = 0; i < regKeys.length; i++) {
    base = '';
    try { base = shell.RegRead(regKeys[i]); } catch (e2) { base = ''; }
    if (base) {
      if (base.charAt(base.length - 1) === '\\') {
        base = base.substring(0, base.length - 1);
      }
      for (var t = 0; t < tails.length; t++) {
        exe = base + tails[t];
        try { if (fso.FileExists(exe)) { return exe; } } catch (e3) {}
      }
    }
  }

  var roots = [];
  var envNames = ['%ProgramFiles%', '%ProgramFiles(x86)%', '%LOCALAPPDATA%\\Programs'];
  for (i = 0; i < envNames.length; i++) {
    try { roots.push(shell.ExpandEnvironmentStrings(envNames[i]) + '\\obs-studio'); } catch (e4) {}
  }
  for (i = 0; i < roots.length; i++) {
    for (var k = 0; k < tails.length; k++) {
      exe = roots[i] + tails[k];
      try { if (fso.FileExists(exe)) { return exe; } } catch (e5) {}
    }
  }
  return '';
}

function doOpenObs() {
  setText('errText', '');
  var exe = findObs();
  if (!exe) {
    setText('errText', 'Could not find OBS automatically - open it manually this time.');
    return;
  }
  try {
    var shell = new ActiveXObject('WScript.Shell');
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    /* OBS needs its own bin folder as the working directory or it fails to
       load its locale files and refuses to start. */
    shell.CurrentDirectory = fso.GetParentFolderName(exe);
    shell.Run('"' + exe + '"', 1, false);
    shell.CurrentDirectory = projectDir;
  } catch (e) {
    setText('errText', 'Found OBS but could not launch it.');
  }
}

function init() {
  try {
    window.resizeTo(WIN_W, WIN_H);
    var x = Math.floor((screen.availWidth - WIN_W) / 2);
    var y = Math.floor((screen.availHeight - WIN_H) / 3);
    window.moveTo(x, y);
  } catch (e) { /* sizing is cosmetic */ }

  projectDir = findProjectDir();
  refreshStatus();
  window.setTimeout(heartbeat, 3000);
}

window.onload = init;
</script>
</body>
</html>
